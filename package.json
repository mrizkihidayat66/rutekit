{
  "name": "rutekit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted AI router & gateway — one OpenAI-compatible endpoint, many providers behind it.",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @rutekit/web dev",
    "dev:server": "bun run --filter @rutekit/server dev",
    "build": "bun run build:web && bun run build:binary && bun run build:npm",
    "build:web": "bun run --filter @rutekit/web build",
    "build:binary": "bun build --compile --asset apps/web/dist apps/server/src/main.ts --outfile dist/rutekit",
    "build:npm": "bun apps/cli/scripts/build-publish.ts",
    "preview": "bun run --filter @rutekit/web preview",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "check:full": "bun run check && bun run test:coverage",
    "ci": "bun run check:full && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/bun": "^1.2.23",
    "@types/node": "^22.18.0",
    "@vitest/coverage-istanbul": "3.2.7",
    "eslint": "^9.37.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "eslint-plugin-rutekit": "workspace:*",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
