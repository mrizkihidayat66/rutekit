# ─────────────────────────────────────────────────────────────
# rutekit — environment template
# Copy to `.env` and fill in. Never commit the real `.env`.
# Every `RUTEKIT_*` variable is validated at boot by the server.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# Bind host. Keep on loopback unless you know why you are exposing it.
RUTEKIT_HOST=127.0.0.1
# Port for the HTTP + WebSocket server.
RUTEKIT_PORT=7331
# The origin the operator's browser uses, as an OAuth provider must be told to
# redirect back to. Defaults to `http://HOST:PORT` above, which is right for a
# direct connection. Set it when the console is served from a different origin —
# a reverse proxy, or `bun run dev` where Vite serves the console and proxies the
# API — or the sign-in will return to an address nothing is listening on.
RUTEKIT_CONSOLE_ORIGIN=

# ── Storage ──────────────────────────────────────────────────
# SQLite database file. Relative paths resolve against the repo root.
RUTEKIT_DATABASE_URL=./data/rutekit.sqlite
# Directory for generated studio assets and automation screenshots.
RUTEKIT_DATA_DIR=./data

# ── Secrets ──────────────────────────────────────────────────
# 32-byte hex key encrypting provider credentials (AES-256-GCM).
# Generate: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RUTEKIT_ENCRYPTION_KEY=
# Argon2id salt/pepper material for the single-user password.
RUTEKIT_AUTH_SECRET=

# ── Egress (C2) ──────────────────────────────────────────────
# Comma-separated CIDRs the outbound guard may still reach. Empty is correct for
# a normal install: providers live on the public internet. Add an entry only when
# a provider genuinely sits on a private network (e.g. 10.0.0.0/8).
#
# A local ComfyUI needs one: it lives on 127.0.0.1:8188, which is a private
# address, and the guard refuses those by default. Rendering with it therefore
# means RUTEKIT_EGRESS_ALLOWLIST=127.0.0.1/32 — the escape hatch doing its job,
# not a bug.
RUTEKIT_EGRESS_ALLOWLIST=

# ── Frontend (build-time, Vite) ──────────────────────────────
# Base path of the API when the web app runs on a different origin.
# Leave empty to use same-origin requests (recommended for self-host).
VITE_API_BASE_URL=
# `on` answers every console request from the mock layer instead of the server.
# Anything else — including leaving this empty — talks to the real server, which
# is the default: `bun run dev` starts both, and the console reads the database.
#
# The mocks are an escape hatch for working on the frontend without a server, or
# for telling a rendering bug from a data bug. A console running on them looks
# exactly like one that is not, so it says so at boot.
VITE_MOCKS=

# ── Automation (FASE C) ──────────────────────────────────────
# Node binary used for the Playwright subprocess (D9). Defaults to `node`.
RUTEKIT_NODE_BINARY=
# Optional capsolver key for captcha assist. Manual assist works without it.
RUTEKIT_CAPSOLVER_KEY=
# Screenshot interval for the live preview stream, milliseconds.
RUTEKIT_PREVIEW_INTERVAL_MS=2000

# ── Pool (C5) ────────────────────────────────────────────────
# How often every account is probed: one authenticated round trip each, proving
# the credential still works and reading the quota window back. Fifteen minutes
# is a compromise — often enough that a dead credential is noticed before an
# operator does, rare enough not to look like abuse.
RUTEKIT_WARMUP_INTERVAL_MS=900000
# Ceiling on one probe. Short on purpose: a probe that hangs is a provider that is
# down, and holding the sweep open behind it delays every other account's check-in.
RUTEKIT_WARMUP_TIMEOUT_MS=15000

# ── Proxy pool (C7a) ─────────────────────────────────────────
# What a proxy health check asks for. The default is a 204 endpoint that returns
# no body, so the check measures reachability rather than downloading a payload.
# Overridable because an instance on a restricted network needs to point it
# somewhere it can actually reach.
RUTEKIT_PROXY_PROBE_URL=https://www.gstatic.com/generate_204
# Ceiling on one proxy probe, milliseconds.
RUTEKIT_PROXY_PROBE_TIMEOUT_MS=8000

# ── Data plane (/v1) ─────────────────────────────────────────
# The three clocks a proxied turn is held to (CONTRIBUTING §5.6). Each is in
# milliseconds and each is a ceiling, not a delay: a provider that misses one is
# reported as a failure rather than waited on.
# How long a provider has to send the *first* byte after accepting the request.
# This one is the only clock that can still become an HTTP error, because the
# response is not committed until the first chunk arrives.
RUTEKIT_STREAM_FIRST_CHUNK_MS=30000
# Longest gap allowed between two chunks of a stream that has already started.
RUTEKIT_STREAM_STALL_MS=60000
# Wall-clock ceiling on the whole upstream call, streaming or not.
RUTEKIT_UPSTREAM_TIMEOUT_MS=300000

# ── Studio (C10) ─────────────────────────────────────────────
# How many renders run at once; the rest wait in `queued`. Two is a deliberate
# middle: a local renderer queues internally and a hosted one rate-limits, so
# serialising below them buys nothing, and a batch of eight opening eight sockets
# buys nothing either.
RUTEKIT_STUDIO_CONCURRENCY=2
# Ceiling on one render, from submit to the file landing. A diffusion run is
# minutes rather than seconds and a cold model cache can be quiet for a while, so
# this is generous on purpose — being too short fails a render that was about to
# finish. It is a ceiling, not a stall guard.
RUTEKIT_STUDIO_TIMEOUT_MS=900000

# ── Benchmark (C11) ──────────────────────────────────────────
# How many cells of a run promptfoo may send at once. Four is deliberate: a
# benchmark compares endpoints under the same conditions, and the calls all land
# on this same instance — saturating the pool would measure contention rather
# than the models.
RUTEKIT_BENCHMARK_CONCURRENCY=4
# Ceiling on one run, from submit to the matrix landing. A matrix is minutes, and
# the ceiling exists so a hung promptfoo cannot hold a workspace for ever.
RUTEKIT_BENCHMARK_TIMEOUT_MS=1800000

# ── Logging ──────────────────────────────────────────────────
# One of: trace | debug | info | warn | error
RUTEKIT_LOG_LEVEL=info
